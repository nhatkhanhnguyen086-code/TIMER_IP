module cnt_ctrl(
	input wire clk, rst_n,
	input wire timer_en,
	input wire div_en,
	input wire div_val,
	input wire neg_timer_en,
	input wire halt_req,
	input wire dbg_mode,

	output reg halt_ack,
	output wire cnt_en,
	output wire cnt_clr
);

reg [7:0] cnt_int_rst_val;
wire cnt_int_rst;
wire cnt_int_en;
reg [7:0]cnt_int;

//Halt_ack
always @(posedge clk or negedge rst_n) begin
	if(!rst_n) begin
		halt_ack <= 1'b0;
	end else begin
		halt_ack <= (dbg_mode && halt_req);
	end
end

//Cnt_int_rst
always @(*) begin
	if(!div_en) cnt_int_rst_val = 8'h0;
	else begin
		case (div_val)
			4'h0: cnt_int_rst_val = 8'd0;
			4'h1: cnt_int_rst_val = 8'd1;
			4'h2: cnt_int_rst_val = 8'd3;
			4'h3: cnt_int_rst_val = 8'd7;
			4'h4: cnt_int_rst_val = 8'd15;
			4'h5: cnt_int_rst_val = 8'd31;
			4'h6: cnt_int_rst_val = 8'd63;
			4'h7: cnt_int_rst_val = 8'd127;
			4'h8: cnt_int_rst_val = 8'd255;
			default: cnt_int_rst_val = 8'd1;
		endcase
	end
end
assign cnt_int_rst = cnt_int_rst_val == cnt_int;

//cnt_int_en
assign cnt_int_en = !halt_ack && timer_en;

//cnt_en
assign cnt_en = cnt_int_en && cnt_int_rst;

//cnt_clr (negedge timer_en)
assign cnt_clr = neg_timer_en;

//cnt_int
always @(posedge clk or negedge rst_n) begin
	if(!rst_n) cnt_int <= 8'h0;
	else begin
		if(cnt_clr || cnt_int_rst) cnt_int <= 8'h0;
		else begin
			if(cnt_int_en) cnt_int <= cnt_int + 1'b1;
			else cnt_int <= cnt_int;
		end
	end
end

endmodule
