module timer_top(
	input wire clk, rst_n,
	input wire psel,
	input wire pwrite,
	input wire penable,
	input wire [11:0]paddr,
	input wire [31:0]pwdata,
	input wire [3:0]pstrb,
	input wire dbg_mode,

	output wire [31:0]prdata,
	output wire pready,
	output wire pslverr,
	output tim_int
);

wire wr_err;
wire wr_en;
wire rd_en;
wire wr_en0;
wire wr_en1;
wire wr_en2;
wire wr_en3;
wire [63:0]cnt;
wire int_st;
wire halt_ack;
wire halt_req;
wire int_en;
wire cnt_en;
wire cnt_clr;
wire timer_en;
wire div_en;
wire div_val;
wire neg_timer_en;
wire clear_int;
wire set_int;

abp_slave apb_slave_u(
	.clk (clk),
	.rst_n (rst_n),
	.pwrite (pwrite),
	.penable (penable),
	.psel (psel),
	.wr_err (wr_err),
	.pstrb (pstrb),
	.pslverr (pslverr),
	.pready (pready),
	.rd_en (rd_en),
	.wr_en0 (wr_en0),
	.wr_en1 (wr_en1),
	.wr_en2 (wr_en2),
	.wr_en3 (wr_en3)
);

register register_u(
	.clk (clk),
	.rst_n (rst_n),
	.wr_err (wr_err),
	.rd_en (rd_en),
	.wr_en0 (wr_en0),
	.wr_en1 (wr_en1),
	.wr_en2 (wr_en2),
	.wr_en3 (wr_en3),
	.cnt (cnt),
	.timer_en (timer_en),
	.div_en (div_en),
	.div_val (div_val),
	.halt_req (halt_req),
	.halt_ack (halt_ack),
	.neg_timer_en (neg_timer_en),
	.set_int (set_int),
	.clear_int (clear_int),
	.int_en (int_en),
	.int_st (int_st),
	.prdata (prdata),
	.paddr (paddr),
	.pwdata (pwdata)
);

cnt_ctrl cnt_ctrl_u(
	.clk (clk),
	.rst_n (rst_n),
	.timer_en (timer_en),
	.div_en (div_en),
	.dbg_mode (dbg_mode),
	.div_val (div_val),
	.halt_req (halt_req),
	.halt_ack (halt_ack),
	.neg_timer_en (neg_timer_en),
	.cnt_en (cnt_en),
	.cnt_clr (cnt_clr)
);

cnt cnt_u(
	.clk (clk),
	.rst_n (rst_n),
	.cnt_en (cnt_en),
	.cnt_clr (cnt_clr),
	.paddr (paddr),
	.pwdata (pwdata),
	.cnt (cnt),
	.wr_en0 (wr_en0),
	.wr_en1 (wr_en1),
	.wr_en2 (wr_en2),
	.wr_en3 (wr_en3),
	.wr_err (wr_err)
);

interrupt interrupt_u(
	.clk (clk),
	.rst_n (rst_n),
	.set_int (set_int),
	.clear_int (clear_int),
	.int_en (int_en),
	.tim_int (tim_int),
	.int_st (int_st)
);

endmodule
