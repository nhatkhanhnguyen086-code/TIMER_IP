module test_bench;
	reg sys_clk;
	reg sys_rst_n;

	reg tim_psel;
	reg tim_penable;
	reg tim_pwrite;
	reg [3:0]tim_pstrb;
	reg [11:0]tim_paddr;
	reg [31:0]tim_pwdata;
	reg dbg_mode;

	wire tim_pready;
	wire tim_pslverr;
	wire tim_int;
	wire [31:0]tim_prdata;

	//golden
	wire [31:0] prdata_exp;
	wire pslverr_exp;
	wire tim_int_exp;
	wire [63:0] cnt_exp;
	wire halt_ack_exp;

	reg [11:0]addr;
	reg [31:0]wdata;
	reg [3:0]pstrb;
	reg [31:0]temp;

	integer i;
	reg [31:0] loop_data;
	reg [4:0] reg_int_chk;



	timer_top dut(
		.sys_clk	(sys_clk	),
		.sys_rst_n	(sys_rst_n	),
		.tim_psel	(tim_psel	),
		.tim_penable	(tim_penable	),
		.tim_pwrite	(tim_pwrite	),
		.tim_pstrb	(tim_pstrb	),
		.tim_paddr	(tim_paddr	),
		.tim_pwdata	(tim_pwdata	),
		.dbg_mode	(dbg_mode	),
		.tim_pready	(tim_pready	),
		.tim_pslverr	(tim_pslverr	),
		.tim_int	(tim_int	),
		.tim_prdata	(tim_prdata	)
	);

	timer_golden_model timer_golden_u(
		.sys_clk	(sys_clk	),
		.sys_rst_n	(sys_rst_n	),
		.tim_psel	(tim_psel	),
		.tim_penable	(tim_penable	),
		.tim_pwrite	(tim_pwrite	),
		.tim_pstrb	(tim_pstrb	),
		.tim_paddr	(tim_paddr	),
		.tim_pwdata	(tim_pwdata	),
		.dbg_mode	(dbg_mode	),
		.tim_pready	(tim_pready	),
		.prdata_exp	(prdata_exp	),
		.pslverr_exp 	(pslverr_exp	),
		.tim_int_exp	(tim_int_exp	)
		
	);

	//golden model
	module timer_golden_model(
		input wire sys_clk, sys_rst_n,
		input wire tim_psel,
		input wire tim_pwrite,
		input wire tim_penable,
		input wire[11:0] tim_paddr,
		input wire [31:0] tim_pwdata,
		input wire [3:0] tim_pstrb,
		input wire dbg_mode,

		input wire tim_pready,

		output reg [31:0] prdata_exp,
		output wire pslverr_exp,
		output wire tim_int_exp,

		output wire [63:0]cnt_exp,
		output wire halt_ack_exp
	);

	reg timer_en_g;
	reg div_en_g;
	reg [3:0] div_val_g;
	reg [63:0] cnt_g;
	reg [7:0] presc_cnt_g;
	reg [31:0] tcmp0_g;
	reg [31:0] tcmp1_g;
	reg int_en_g;
	reg int_st_g;
	reg halt_req_g;

	assign cnt_exp = cnt_g;
	assign halt_ack_exp = dbg_mode && halt_req_g;
	assign tim_int_exp = int_en_g && int_st_g;

	wire wr_valid = tim_psel && tim_penable && tim_pready && tim_pwrite;
	wire rd_valid = tim_psel && tim_penable && tim_pready && !tim_pwrite;

	wire tcr_wr_b0 = wr_valid && (tim_paddr == 12'h0) && tim_pstrb[0];
	wire tcr_wr_b1 = wr_valid && (tim_paddr == 12'h0) && tim_pstrb[1];

	wire tdr0_wr_b0 = wr_valid && (tim_paddr == 12'h4) && tim_pstrb[0];
	wire tdr0_wr_b1 = wr_valid && (tim_paddr == 12'h4) && tim_pstrb[1];
	wire tdr0_wr_b2 = wr_valid && (tim_paddr == 12'h4) && tim_pstrb[2];
	wire tdr0_wr_b3 = wr_valid && (tim_paddr == 12'h4) && tim_pstrb[3];
	
	wire tdr1_wr_b0 = wr_valid && (tim_paddr == 12'h8) && tim_pstrb[0];
	wire tdr1_wr_b1 = wr_valid && (tim_paddr == 12'h8) && tim_pstrb[1];
	wire tdr1_wr_b2 = wr_valid && (tim_paddr == 12'h8) && tim_pstrb[2];
	wire tdr1_wr_b3 = wr_valid && (tim_paddr == 12'h8) && tim_pstrb[3];

	wire tcmp0_wr_b0 = wr_valid && (tim_paddr == 12'hc) && tim_pstrb[0];
	wire tcmp0_wr_b1 = wr_valid && (tim_paddr == 12'hc) && tim_pstrb[1];
	wire tcmp0_wr_b2 = wr_valid && (tim_paddr == 12'hc) && tim_pstrb[2];
	wire tcmp0_wr_b3 = wr_valid && (tim_paddr == 12'hc) && tim_pstrb[3];

	wire tcmp1_wr_b0 = wr_valid && (tim_paddr == 12'h10) && tim_pstrb[0];
	wire tcmp1_wr_b1 = wr_valid && (tim_paddr == 12'h10) && tim_pstrb[1];
	wire tcmp1_wr_b2 = wr_valid && (tim_paddr == 12'h10) && tim_pstrb[2];
	wire tcmp1_wr_b3 = wr_valid && (tim_paddr == 12'h10) && tim_pstrb[3];

	wire tier_wr_b0 = wr_valid && (tim_paddr == 12'h14) && tim_pstrb[0];
	wire tisr_wr_b0 = wr_valid && (tim_paddr == 12'h18) && tim_pstrb[0];
	wire thcsr_wr_b0 = wr_valid && (tim_paddr == 12'h1c) && tim_pstrb[0];
	
	wire div_en_err = tcr_wr_b0 && timer_en_g && (tim_pwdata[1] != div_en_g);
	wire div_val_err0 = tcr_wr_b1 && timer_en_g && (tim_pwdata[11:8] != div_val_g);
	wire div_val_err1 = tcr_wr_b1 && (tim_pwdata[11:8] > 4'h8);

	assign pslverr_exp = div_en_err || div_val_err0 || div_val_err1;
	
	wire timer_en_negedge = tcr_wr_b0 && timer_en_g && !tim_pwdata[0];
	wire cnt_tick_en = timer_en_g && !halt_ack_exp;

	wire [15:0] presc_target_full = div_en_g ? ((16'h1 << div_val_g) - 16'h1) : 16'h0;
	wire [7:0] presc_target = presc_target_full[7:0];

	wire tdr_wr_allowed = !timer_en_g;

	always @(posedge sys_clk or negedge sys_rst_n) begin
		if(!sys_rst_n) begin
			div_val_g <= 4'b0001;
			div_en_g <= 1'b0;
			timer_en_g <= 1'b0;
			cnt_g <= 64'h0;
			presc_cnt_g <= 8'h0;
			tcmp0_g <= 32'hffff_ffff;
			tcmp1_g <= 32'hffff_ffff;
			int_en_g <= 1'b0;
			int_st_g <= 1'b0;
			halt_req_g <= 1'b0;
		end else begin
			if(tcr_wr_b0 && !pslverr_exp) begin
				timer_en_g <= tim_pwdata[0];
				div_en_g <= tim_pwdata[1];
			end
			if(tcr_wr_b1 && !pslverr_exp) begin
				div_val_g <= tim_pwdata[11:8];
			end

			if(tcmp0_wr_b0) tcmp0_g[7:0] <= tim_pwdata[7:0];
			if(tcmp0_wr_b1) tcmp0_g[15:8] <= tim_pwdata[15:8];
			if(tcmp0_wr_b2) tcmp0_g[23:16] <= tim_pwdata[23:16];
			if(tcmp0_wr_b3) tcmp0_g[31:24] <= tim_pwdata[31:24];

			if(tcmp1_wr_b0) tcmp1_g[7:0] <= tim_pwdata[7:0];
			if(tcmp1_wr_b1) tcmp1_g[15:8] <= tim_pwdata[15:8];
			if(tcmp1_wr_b2) tcmp1_g[23:16] <= tim_pwdata[23:16];
			if(tcmp1_wr_b3) tcmp1_g[31:24] <= tim_pwdata[31:24];

			if(tier_wr_b0) int_en_g <= tim_pwdata[0];
			if(thcsr_wr_b0) halt_req_g <= tim_pwdata[0];

			if(timer_en_negedge) begin
				cnt_g <= 64'h0;
				presc_cnt_g <= 8'h0;
			end else if(cnt_tick_en) begin
				if(presc_cnt_g == presc_target) begin
					presc_cnt_g <= 8'h0;
					cnt_g <= cnt_g + 64'h1;
				end else begin
					presc_cnt_g <= presc_cnt_g + 8'h1;
				end
			end else if(tdr_wr_allowed) begin
				if(tdr0_wr_b0) cnt_g[7:0] <= tim_pwdata[7:0];
				if(tdr0_wr_b1) cnt_g[15:8] <= tim_pwdata[15:8];
				if(tdr0_wr_b2) cnt_g[23:16] <= tim_pwdata[23:16];
				if(tdr0_wr_b3) cnt_g[31:24] <= tim_pwdata[31:24];

				if(tdr1_wr_b0) cnt_g[39:32] <= tim_pwdata[7:0];
				if(tdr1_wr_b1) cnt_g[47:40] <= tim_pwdata[15:8];
				if(tdr1_wr_b2) cnt_g[55:48] <= tim_pwdata[23:16];
				if(tdr1_wr_b3) cnt_g[63:56] <= tim_pwdata[31:24];
			end
		if(tisr_wr_b0  && tim_pwdata[0]) begin
			int_st_g <= 1'b0;
		end else if(cnt_g == {tcmp1_g, tcmp0_g}) begin
			int_st_g <= 1'b1;
		end
		end
	end

	always @(*) begin
		if(!rd_valid) begin
			prdata_exp = 32'h0;
		end else begin
			case (tim_paddr)
				12'h0: prdata_exp = {20'h0, div_val_g, 6'h0, div_en_g, timer_en_g};
				12'h4: prdata_exp = cnt_g[31:0];
				12'h8: prdata_exp = cnt_g[63:32];
				12'hc: prdata_exp = tcmp0_g;
				12'h10: prdata_exp = tcmp1_g; 
				12'h14: prdata_exp = {31'h0, int_en_g}; 
				12'h18: prdata_exp = {31'h0, int_st_g}; 
				12'h1c: prdata_exp = {30'h0, halt_ack_exp, halt_req_g};
				default: prdata_exp = 32'h0;
			endcase
		end
	end
	endmodule

	initial begin
		sys_clk = 1'b0;
		forever #25 sys_clk = ~sys_clk; 
	end

	initial begin
		$display("---------------------------------------");
		$display("-----------   REG_INT_CHK   -----------");
		$display("---------------------------------------");
		#100;
		#1;
		sys_rst_n = 1'b0;
		#100;
		#1;
		sys_rst_n = 1'b1;
		#100;
		#1;
		rd_task(12'h0);
		rd_task(12'h4);
		rd_task(12'h8);
		rd_task(12'hC);
		rd_task(12'h10);
		rd_task(12'h14);
		rd_task(12'h18);
		rd_task(12'h1C);
		$display("------  REG_INT_CHK --  PASSED  -------");
		#100;

	

		$display("---------------------------------------");
		$display("-----------   REG_RW_CHK   ------------");
		$display("---------------------------------------");
	
		//TDR	
		wr_task(12'h4, 32'h0, 4'hf);
		rd_task(12'h4);
		wr_task(12'h4, 32'hffff_ffff, 4'hf);
		rd_task(12'h4);
		wr_task(12'h4, 32'h5555_5555, 4'hf);
		rd_task(12'h4);
		wr_task(12'h4, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h4);

		wr_task(12'h8, 32'h0, 4'hf);
		rd_task(12'h8);
		wr_task(12'h8, 32'hffff_ffff, 4'hf);
		rd_task(12'h8);
		wr_task(12'h8, 32'h5555_5555, 4'hf);
		rd_task(12'h8);
		wr_task(12'h8, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h8);
		$display("------");

		//TCMP
		wr_task(12'hC, 32'h0, 4'hf);
		rd_task(12'hc);
		wr_task(12'hc, 32'hffff_ffff, 4'hf);
		rd_task(12'hc);
		wr_task(12'hc, 32'h5555_5555, 4'hf);
		rd_task(12'hc);
		wr_task(12'hc, 32'haaaa_aaaa, 4'hf);
		rd_task(12'hc);

		wr_task(12'h10, 32'h0, 4'hf);
		rd_task(12'h10);
		wr_task(12'h10, 32'hffff_ffff, 4'hf);
		rd_task(12'h10);
		wr_task(12'h10, 32'h5555_5555, 4'hf);
		rd_task(12'h10);
		wr_task(12'h10, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h10);


		$display("------");
		//timer_en=0, write div_val <= 8
		loop_data = 32'h0;
		for(i = 0; i<=8; i = i +1) begin
			wr_task(12'h0, loop_data, 4'hf);
			rd_task(12'h0);
			loop_data = loop_data + 32'h100;
		end

		//TIER
		wr_task(12'h14, 32'h0, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'hffff_ffff, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'h5555_5555, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h14);
		$display("------");

		//THCSR
		dbg_mode = 1'b0;
		wr_task(12'h1c, 32'h1, 4'h1);
		rd_task(12'h1c);
		wr_task(12'h1c, 32'h0, 4'h1);
		rd_task(12'h1c);

		$display("-------  REG_RW_CHK --  PASSED  -------");

		$display("---------------------------------------");
		$display("---------   REG_RESERVED_CHK   --------");
		$display("---------------------------------------");
		rd_task(12'h2);
		wr_task(12'hf, 32'hffff_ffff, 4'hf);
		rd_task(12'hf);

		$display("------");
		//TCR
		wr_task(12'h0, 32'h0, 4'hf);
		rd_task(12'h0);
		wr_task(12'h0, 32'hffff_ffff, 4'hf);
		rd_task(12'h0);
		wr_task(12'h0, 32'h5555_5555, 4'hf);
		rd_task(12'h0);
		wr_task(12'h0, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h0);

		$display("------");
		//TIER
		wr_task(12'h14, 32'h0, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'hffff_ffff, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'h5555_5555, 4'hf);
		rd_task(12'h14);
		wr_task(12'h14, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h14);

		$display("------");
		//TISR
		wr_task(12'h18, 32'h0, 4'hf);
		rd_task(12'h18);
		wr_task(12'h18, 32'hffff_ffff, 4'hf);
		rd_task(12'h18);
		wr_task(12'h18, 32'h5555_5555, 4'hf);
		rd_task(12'h18);
		wr_task(12'h18, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h18);

		$display("------");
		//THCSR	
		wr_task(12'h1c, 32'h0, 4'hf);
		rd_task(12'h1c);
		wr_task(12'h1c, 32'hffff_ffff, 4'hf);
		rd_task(12'h1c);
		wr_task(12'h1c, 32'h5555_5555, 4'hf);
		rd_task(12'h1c);
		wr_task(12'h1c, 32'haaaa_aaaa, 4'hf);
		rd_task(12'h1c);

		$display("----  REG_RESERVED_CHK --  PASSED  ----");

		$display("---------------------------------------");
		$display("-------   REG_BYTE_ACCESS_CHK   -------");
		$display("---------------------------------------");
		wr_task(12'h4, 32'haaaa_aaaa, 4'hf);
		wr_task(12'h4, 32'h1111_1111, 4'h1);
		rd_task(12'h4);
		$display("------");
		wr_task(12'h4, 32'h2222_2222, 4'h2);
		rd_task(12'h4);
		$display("------");
		wr_task(12'h4, 32'h3333_3333, 4'h4);
		rd_task(12'h4);
		$display("------");
		wr_task(12'h4, 32'h4444_4444, 4'h8);
		rd_task(12'h4);
		$display("------");
		wr_task(12'hc, 32'h0, 4'hf);
		wr_task(12'hc, 32'hbbbb_dddd, 4'b1010);
		rd_task(12'hc);
		$display("------");
		wr_task(12'h10, 32'h1234_5678, 4'hf);
		wr_task(12'h10, 32'h0, 4'h0);
		rd_task(12'h10);

		$display("--  REG_BYTE_ACCESS_CHK --  PASSED  ---");

		$display("---------------------------------------");
		$display("--------   CNT_COUNTING_CHK   ---------");
		$display("---------------------------------------");

		//div_en=0
		reset;
		wr_task(12'h0, 32'h1, 4'h1);
		repeat(100) @(posedge sys_clk);
		#1;
		rd_task(12'h4);	
		$display("------");

		//count with div_en
		reset;
		loop_data = 32'h2;
		for(i=0; i <= 8; i = i + 1) begin
			reset;
			wr_task(12'h0, loop_data, 4'h2);
			wr_task(12'h0, 32'h3, 4'h1);
			repeat(1000) @(posedge sys_clk);
			#1;
			rd_task(12'h4);
			rd_task(12'h8);
			loop_data = loop_data + 32'h100;
		end
		$display("------");
		//reach tcmp and counts countinous
		reset;
		wr_task(12'hc, 32'ha, 4'hf);
		wr_task(12'h0, 32'h1, 4'h1);
		repeat(11) @(posedge sys_clk);
		#1;
		rd_task(12'h18);
		rd_task(12'h4);
		repeat(5) @(posedge sys_clk);
		#1;
		rd_task(12'h4);

		$display("------");
		//overflow
		reset;
		wr_task(12'h4, 32'hffff_ffff, 4'hf);
		wr_task(12'h8, 32'hffff_ffff, 4'hf);
		wr_task(12'h0, 32'h1, 4'h1);
		@(posedge sys_clk);
		@(posedge sys_clk);
		#1;
		rd_task(12'h4);
		rd_task(12'h8);
		$display("------");
		//check timer_en H -> L, clear cnt
		rd_task(12'h4);
		wr_task(12'h0, 32'h0, 4'h1);
		rd_task(12'h4);
		$display("------");
		//check counter counts countinous
		rd_task(12'h4);
		wr_task(12'h0, 32'h1, 4'h1);
		@(posedge sys_clk);
		#1;
		rd_task(12'h4);
		$display("------");
		//counts from radom value, not 0
		wr_task(12'h0, 32'h0, 4'h1);
		wr_task(12'h4, 32'ha, 4'hf);
		rd_task(12'h4);
		wr_task(12'h0, 32'h1, 4'h1);
		@(posedge sys_clk);
		#1;
		rd_task(12'h4);
		$display("----  CNT_COUNTING_CHK --  PASSED  ----");

		$display("---------------------------------------");
		$display("----------   INTERRUPT_CHK   ----------");
		$display("---------------------------------------");

		reset;
		//match
		wr_task(12'hc, 32'ha, 4'hf);
		wr_task(12'h10, 32'h0, 4'hf);
		wr_task(12'h0, 32'h1, 4'h1);
		repeat(11) @(posedge sys_clk);
		#1;
		rd_task(12'h18);
		$display("------");
		if(tim_int == tim_int_exp) $display("[PASSED] TIM_INT = %b", tim_int);
		else $display("[FAILED]");
		wr_task(12'h14, 32'h1, 4'h1);
		if(tim_int == tim_int_exp) $display("[PASSED] TIM_INT = %b", tim_int);
		else $display("[FAILED]");
		$display("------");
		//int_st = 1, write int_st = 1 | 0
		wr_task(12'h18, 32'h0, 4'h1);
		rd_task(12'h18);
		wr_task(12'h18, 32'h1, 4'h1);
		rd_task(12'h18);
		$display("------");
		//int_st = 0, write  int_st = 1
		wr_task(12'h18, 32'h1, 4'h1);
		rd_task(12'h18);
		$display("------");
		reset;
		wr_task(12'hc, 32'ha, 4'hf);
		wr_task(12'h10, 32'h0, 4'hf);
		wr_task(12'h0, 32'h1, 4'h1);
		repeat(11) @(posedge sys_clk);
		#1;
		rd_task(12'h18);
		wr_task(12'h14, 32'h1, 4'h1);
		if(tim_int == tim_int_exp) $display("[PASSED] TIM_INT = %b", tim_int);
		else $display("[FAILED]");

		wr_task(12'h14, 32'h0, 4'h1);
		if(tim_int == tim_int_exp) $display("[PASSED] TIM_INT = %b", tim_int);
		else $display("[FAILED]");
		$display("------");
		reset;
		//match
		wr_task(12'hc, 32'ha, 4'hf);
		wr_task(12'h10, 32'h0, 4'hf);
		wr_task(12'h0, 32'h1, 4'h1);
		repeat(8) @(posedge sys_clk);
		#1;
		wr_task(12'h18, 32'h1, 4'h1);
		rd_task(12'h18);
		$display("-----  INTERRUPT_CHK  --  PASSED  -----");
		$display("---------------------------------------");
		$display("--------   APB_PSLVERR_CHECK   --------");
		$display("---------------------------------------");

		reset;
		#1000;
		#1;
		//TIMER_EN = 0, DIV_EN = 0 OR 1, CHECK ERROR
		if(tim_pslverr == pslverr_exp) $display("[PASSED] PSLVERR = %b | PSLVERR_ACTUAL = %b", pslverr_exp , tim_pslverr);
