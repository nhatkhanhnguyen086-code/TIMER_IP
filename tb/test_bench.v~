task wr_task;
	input [11:0]addr;
	input [31:0]wdata;
	input [3:0]pstrb;
	begin
		tim_pwrite = 1'b1;
		tim_psel = 1'b1;
		tim_paddr = addr;
		tim_pwdata = wdata;
		tim_pstrb = pstrb;
		tim_penable = 1'b0;
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b1;
		repeat(2) @(posedge sys_clk);
		#1;
		tim_penable = 1'b0;
		tim_pwrite = 1'b0;
		tim_psel = 1'b0;
	end
endtask

task wr_task_err_chk;
	input [11:0]addr;
	input [31:0]wdata;
	input [3:0]pstrb;
	begin
		tim_pwrite = 1'b1;
		tim_psel = 1'b1;
		tim_paddr = addr;
		tim_pwdata = wdata;
		tim_pstrb = pstrb;
		tim_penable = 1'b0;
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b1;
		@(posedge sys_clk);
		#1;
		if(tim_pslverr == pslverr_exp) $display("[PASSED] PSLVERR = %b | PSLVERR_ACTUAL = %b", pslverr_exp , tim_pslverr);
		else begin
			$display("[FAILED] PSLVERR = %b | PSLVERR_ACTUAL = %b", pslverr_exp , tim_pslverr);
			$finish;
		end
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b0;
		tim_pwrite = 1'b0;
		tim_psel = 1'b0;
	end
endtask

task rd_task;
	input [11:0]addr;
	begin
		tim_pwrite = 1'b0;
		tim_psel = 1'b1;
		tim_paddr = addr;
		tim_penable = 1'b0;
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b1;
		@(posedge sys_clk);
		#1;
		#1;
		if(tim_prdata == prdata_exp) begin
			$display("[PASSED] ADDR = %h | RDATA = %h | ACTUAL = %h", tim_paddr, prdata_exp, tim_prdata);
		end else begin
		$display("[FAILED] ADDR = %h | RDATA = %h | ACTUAL = %h", tim_paddr, prdata_exp, tim_prdata);
		$finish;
		end
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b0;
		tim_psel = 1'b0;
	end
endtask

task rd_task_out;
	input [11:0]addr;
	output [31:0]temp;
	begin
		tim_pwrite = 1'b0;
		tim_psel = 1'b1;
		tim_paddr = addr;
		tim_penable = 1'b0;
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b1;
		@(posedge sys_clk);
		#1;
		#1;
		temp = tim_prdata;
		@(posedge sys_clk);
		#1;
		tim_penable = 1'b0;
		tim_psel = 1'b0;
	end
endtask


task reset;
	begin
		//TCR
		rd_task_out(12'h0, temp);
		if(temp[1]) wr_task(12'h0, 32'h2, 4'h1);
		else wr_task(12'h0, 32'h0, 4'h1);

		wr_task(12'h0, 32'h0000_0100, 4'hf);
		//TDR
		wr_task(12'h4, 32'h0, 4'hf);
		wr_task(12'h8, 32'h0, 4'hf);
		//TCMP
		wr_task(12'hc, 32'hffff_ffff, 4'hf);
		wr_task(12'h10, 32'hffff_ffff, 4'hf);
		//TIER
		wr_task(12'h14, 32'h0, 4'h1);
		//TISR
		wr_task(12'h18, 32'h1, 4'h1);
		//THCSR
		wr_task(12'h1c, 32'h0, 4'h1);
		
	end
endtask

